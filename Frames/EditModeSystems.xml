<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">
	<!-- Whoa unit frames inherit stock Edit Mode system templates.
	     Ref: Blizzard_EditMode/Shared/EditModeSystemTemplates.xml
	          Blizzard_UnitFrame/Classic/PlayerFrame.xml, TargetFrame.xml -->
	<Button name="WhoaUFPlayerEditModeTemplate" inherits="SecureUnitButtonTemplate, EditModePlayerFrameSystemTemplate" movable="true" virtual="true"/>

	<Button name="WhoaUFTargetEditModeTemplate" inherits="SecureUnitButtonTemplate, EditModeUnitFrameSystemTemplate" movable="true" virtual="true">
		<KeyValues>
			<KeyValue key="systemIndex" value="Enum.EditModeUnitFrameSystemIndices.Target" type="global"/>
			<KeyValue key="systemNameString" value="HUD_EDIT_MODE_TARGET_FRAME_LABEL" type="global"/>
			<KeyValue key="defaultHideSelection" value="true" type="boolean"/>
		</KeyValues>
	</Button>

	<Button name="WhoaUFFocusEditModeTemplate" inherits="SecureUnitButtonTemplate, EditModeUnitFrameSystemTemplate" movable="true" clampedToScreen="true" virtual="true">
		<KeyValues>
			<KeyValue key="systemIndex" value="Enum.EditModeUnitFrameSystemIndices.Focus" type="global"/>
			<KeyValue key="systemNameString" value="HUD_EDIT_MODE_FOCUS_FRAME_LABEL" type="global"/>
			<KeyValue key="defaultHideSelection" value="true" type="boolean"/>
		</KeyValues>
	</Button>

	<Frame name="WhoaUFPartyEditModeTemplate" inherits="EditModeUnitFrameSystemTemplate" movable="true" clampedToScreen="true" virtual="true">
		<KeyValues>
			<KeyValue key="systemIndex" value="Enum.EditModeUnitFrameSystemIndices.Party" type="global"/>
			<KeyValue key="systemNameString" value="HUD_EDIT_MODE_PARTY_FRAMES_LABEL" type="global"/>
			<KeyValue key="defaultHideSelection" value="true" type="boolean"/>
			<KeyValue key="breakSnappedFramesOnSave" value="true" type="boolean"/>
			<KeyValue key="alwaysUseTopLeftAnchor" value="true" type="boolean"/>
		</KeyValues>
	</Frame>
</Ui>
